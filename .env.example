POSTGRES_PASSWORD=<generate-me>
APP_DB_PASSWORD=<generate-me>
DATABASE_URL=postgresql+psycopg://frontdesk_app:<APP_DB_PASSWORD>@localhost:5432/frontdesk
MIGRATION_DATABASE_URL=postgresql+psycopg://frontdesk_owner:<POSTGRES_PASSWORD>@localhost:5432/frontdesk
SESSION_SECRET=<generate-me>
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
SWEEP_ENABLED=true
# D-045/D-046: position from the right of the client's X-Forwarded-For entry; 0 = socket peer (local), 3 = Render
TRUSTED_PROXY_HOPS=0
# scripts/seed.py demo accounts (>= 12 chars); only for demo/evaluation databases
SEED_DEMO_PASSWORD=<generate-me>
