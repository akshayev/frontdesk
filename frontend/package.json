{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings src",
    "test": "vitest run",
    "gen:api": "cd ../backend && uv run python -m scripts.export_openapi > ../frontend/openapi.json && cd ../frontend && npx openapi-typescript openapi.json -o src/api/schema.d.ts",
    "check:api": "npm run gen:api && git diff --exit-code -- openapi.json src/api/schema.d.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.90.0",
    "typescript": "5.9.3",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  }
}
